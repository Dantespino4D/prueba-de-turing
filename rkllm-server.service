[Unit]
Description=RKLLM Server (Flask, NPU RK3588)
After=network.target

[Service]
Type=simple
User=dante
WorkingDirectory=/home/dante/rknn-llm/examples/rkllm_server_demo/rkllm_server

# Para cambiar de modelo: editar MODEL_PATH y reiniciar el servicio.
Environment="MODEL_PATH=/home/dante/jarvis/llama3.1-supernova-instruct-merge-ab.rkllm"
Environment="LD_LIBRARY_PATH=/home/dante/rknn-llm/examples/rkllm_server_demo/rkllm_server/lib"
Environment="PYTHONUNBUFFERED=1"

# El puerto (8085) esta fijo en app.run() de flask_server.py; para cambiarlo hay que editar ese archivo.
ExecStart=/home/dante/rknn-llm/examples/rkllm_server_demo/venv/bin/python flask_server.py --rkllm_model_path ${MODEL_PATH} --target_platform rk3588

Restart=on-failure
RestartSec=5
# El modelo 8B puede tardar 4-6 minutos en cargar; sin este valor systemd
# lo mataría antes de que esté listo.
TimeoutStartSec=600
LimitNOFILE=102400

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rkllm-server

[Install]
WantedBy=multi-user.target
