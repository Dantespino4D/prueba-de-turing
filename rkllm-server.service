[Unit]
Description=RKLLM Server Demo (Flask, NPU RK3588)
After=network.target
# Iniciar después del driver NPU si existe como servicio
# After=rknpu.service

[Service]
Type=simple
User=dante
WorkingDirectory=/home/dante/rknn-llm/examples/rkllm_server_demo/rkllm_server

# Ajusta MODEL_PATH al modelo que quieras cargar.
# Cambiar de modelo requiere reiniciar este servicio.
Environment="MODEL_PATH=/home/dante/jarvis/llama3.1-supernova-instruct-merge-ab.rkllm"
Environment="RKLLM_PORT=8080"

# Activar venv del proyecto
ExecStartPre=/bin/bash -c 'source /home/dante/rknn-llm/examples/rkllm_server_demo/venv/bin/activate'
ExecStart=/bin/bash -c '\
  source /home/dante/rknn-llm/examples/rkllm_server_demo/venv/bin/activate && \
  python flask_server.py \
    --rkllm_model_path ${MODEL_PATH} \
    --target_platform rk3588'

# Reiniciar automáticamente si falla (excepto al parar manualmente)
Restart=on-failure
RestartSec=5

# Límites para la NPU
LimitNOFILE=102400

# Variables de entorno para la librería nativa
Environment="LD_LIBRARY_PATH=/home/dante/rknn-llm/examples/rkllm_server_demo/rkllm_server/lib:$LD_LIBRARY_PATH"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rkllm-server

[Install]
WantedBy=multi-user.target
